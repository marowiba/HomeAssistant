# Vorlage fuer /etc/signal-cli/signal-cli.env
#
# Diese Datei enthaelt die Telefonnummer des dedizierten Signal-Kontos.
# Die Nummer ist personenbezogen und gehoert nicht ins Repository.
#
# Auf srv001:
#   sudo install -o root -g signal-cli -m 0640 \
#        signal-cli.env.example /etc/signal-cli/signal-cli.env
#   sudoedit /etc/signal-cli/signal-cli.env
#
# Platzhalter durch die echte Nummer im Format +49... ersetzen.

SIGNAL_ACCOUNT=+49XXXXXXXXXX
