# HAD-0008: Umgebung fuer die Signal-Administration
#
# Nach /etc/signal-admin/signal-admin.env kopieren und anpassen.
# Rechte: 0640 root:signal-admin
#
# SIGNAL_ADMIN_HOST: 127.0.0.1 fuer rein lokalen Betrieb, sonst die LAN-Adresse
#                    von srv001 (z. B. 192.168.1.10). Niemals 0.0.0.0 ohne
#                    Firewall-Beschraenkung.
# SIGNAL_ADMIN_PORT: Port der Weboberflaeche.
# SIGNAL_ADMIN_SECRET: Zufaelliger Wert fuer CSRF-Token. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

SIGNAL_ADMIN_HOST=127.0.0.1
SIGNAL_ADMIN_PORT=8090
SIGNAL_ADMIN_SECRET=REPLACE_WITH_RANDOM_SECRET
